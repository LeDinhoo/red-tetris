{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage --coverage.include=\"src/**/*.{ts,svelte}\" --coverage.exclude=\"**/*.test.ts\" --coverage.exclude=\"**/*.spec.ts\" --coverage.exclude=\"**/node_modules/**\" --coverage.exclude=\"**/dist/**\" --coverage.exclude=\"**/coverage/**\"",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^4.3.3"
  }
}
